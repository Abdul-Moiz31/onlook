{
  "name": "@onlook/web",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node api.js && bun --filter '@onlook/web-client' --filter '@onlook/web-preload' dev",
    "dev:client": "node api.js && bun --filter @onlook/web-client dev",
    "dev:server": "node api.js && bun --filter @onlook/web-server dev",
    "dev:preload": "node api.js && bun --filter @onlook/web-preload dev",
    "build:client": "bun --filter @onlook/web-client build",
    "start:client": "node api.js && bun --filter @onlook/web-client start",
    "docker:up": "docker compose up",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker compose up"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {}
}
